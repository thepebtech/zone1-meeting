rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['name', 'text', 'createdAt'])
        && data.keys().hasOnly(['name', 'text', 'createdAt', 'timestamp'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && data.text is string && data.text.size() > 0 && data.text.size() <= 300
        && data.createdAt is timestamp && incoming().createdAt == request.time
        && (!('timestamp' in data) || (data.timestamp is string && data.timestamp.size() <= 20));
    }

    // Public real-time comments for live stream prayer points & greetings
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isValidId(commentId) && isValidComment(incoming());
      allow update, delete: if false;
    }
  }
}
